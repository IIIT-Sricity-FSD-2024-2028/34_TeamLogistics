{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": [
    "<rootDir>/setup-e2e.js"
  ],
  "transform": {
    "^.+[\\\\/]@nestjs[\\\\/]jwt[\\\\/].+\\.js$": "<rootDir>/jwt-transform.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/jwt)/)"
  ]
}
